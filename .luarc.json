{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "Lua.runtime.version": "LuaJIT",
  "Lua.runtime.path": ["?.lua", "?/init.lua"],
  "Lua.diagnostics.enable": true,
  "Lua.diagnostics.globals": ["vim", "Snacks"],
  "Lua.diagnostics.unusedLocalExclude": ["_*"],
  "Lua.diagnostics.disable": ["lowercase-global"],
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.maxPreload": 2000,
  "Lua.workspace.preloadFileSize": 500,
  "Lua.completion.callSnippet": "Replace",
  "Lua.completion.keywordSnippet": "Replace",
  "Lua.hint.enable": true,
  "Lua.hint.arrayIndex": "Disable",
  "Lua.hint.await": true,
  "Lua.hint.paramName": "All",
  "Lua.hint.paramType": true,
  "Lua.hint.setType": false,
  "Lua.hint.semicolon": "Disable",
  "Lua.codelens.enable": true,
  "Lua.telemetry.enable": false,
  "Lua.format.enable": false,
  "Lua.doc.privateName": ["^_"]
}
